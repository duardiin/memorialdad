# Variáveis do Painel Administrativo (/admin). Veja PAINEL-ADMIN.md.
# Na Vercel: Project → Settings → Environment Variables.
# Para testar no computador: copie para .env.local (sem GITHUB_TOKEN, o painel grava nos arquivos locais).

# Texto aleatório com pelo menos 32 caracteres. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ATENÇÃO: se for trocado, as contas criadas no painel deixam de funcionar (a conta principal continua).
ADMIN_SECRET=

# Conta principal (sempre funciona; serve para recuperar o acesso)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Acesso ao repositório do GitHub onde o conteúdo é gravado
GITHUB_TOKEN=
GITHUB_REPO=duardiin/memorialdad
GITHUB_BRANCH=main
