rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: events
    // Document ID: auto-generated
    // Fields:
    //   - year: integer (required) - The year of the event
    //   - tag: string (required, enum) - The category of the event
    //   - title: string (required, max 100 chars) - The title of the event
    //   - desc: string (required, max 1000 chars) - A detailed description
    //   - authorUid: string (required, immutable) - The UID of the creator
    //   - createdAt: timestamp (required, immutable) - When it was created
    //
    // Collection: photos
    // Document ID: auto-generated
    // Fields:
    //   - year: integer (required) - The year of the photo
    //   - url: string (required, valid URL) - The URL of the image
    //   - caption: string (required, max 500 chars) - The caption for the photo
    //   - authorUid: string (required, immutable) - The UID of the creator
    //   - createdAt: timestamp (required, immutable) - When it was created
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          (request.auth.token.email == "psergio@ufv.br" && request.auth.token.email_verified == true));
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function isValidUrl(url) {
      return url is string && (url.matches("^https://.*") || url.matches("^http://.*") || url.matches("^data:image/.*"));
    }

    function isValidEvent(data) {
      return hasRequiredFields(['year', 'tag', 'title', 'desc', 'authorUid', 'createdAt']) &&
             hasOnlyAllowedFields(['year', 'tag', 'title', 'desc', 'authorUid', 'createdAt']) &&
             data.year is int &&
             data.tag in ['fundacao', 'ensino', 'pesquisa', 'extensao', 'gestao', 'infraestrutura', 'reconhecimento', 'parceria'] &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 100 &&
             data.desc is string && data.desc.size() > 0 && data.desc.size() <= 1000 &&
             data.authorUid == request.auth.uid &&
             data.createdAt == request.time;
    }

    function isValidPhoto(data) {
      return hasRequiredFields(['year', 'url', 'caption', 'authorUid', 'createdAt']) &&
             hasOnlyAllowedFields(['year', 'url', 'caption', 'authorUid', 'createdAt']) &&
             data.year is int &&
             isValidUrl(data.url) &&
             data.caption is string && data.caption.size() > 0 && data.caption.size() <= 500 &&
             data.authorUid == request.auth.uid &&
             data.createdAt == request.time;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /events/{eventId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidEvent(request.resource.data);
      allow update: if isAuthenticated() && (isOwner(resource.data.authorUid) || isAdmin()) && 
                    isValidEvent(request.resource.data) &&
                    request.resource.data.authorUid == resource.data.authorUid &&
                    request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAuthenticated() && (isOwner(resource.data.authorUid) || isAdmin());
    }

    match /photos/{photoId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidPhoto(request.resource.data);
      allow update: if isAuthenticated() && (isOwner(resource.data.authorUid) || isAdmin()) && 
                    isValidPhoto(request.resource.data) &&
                    request.resource.data.authorUid == resource.data.authorUid &&
                    request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isAuthenticated() && (isOwner(resource.data.authorUid) || isAdmin());
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && 
                    hasOnlyAllowedFields(['role', 'email', 'name']) &&
                    request.resource.data.role == 'user';
      allow update: if isAdmin();
    }
  }
}
